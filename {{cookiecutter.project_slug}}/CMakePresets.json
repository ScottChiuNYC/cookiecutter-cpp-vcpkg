{
  "version": "3.0.0",
  "configurePresets": [
    {
      "name": "vcpkg",
      "description": "Build using vcpkg integration",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/cmake.toolchain.cmake"
      },
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg-debug",
      "configurePreset": "vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg",
      "configuration": "Release"
    }
  ]
}
